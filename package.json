{
  "name": "pi-revdiff-plan",
  "repository": "github:a4180p/pi-revdiff-plan",
  "version": "0.1.3",
  "type": "module",
  "description": "Pi plan mode with revdiff TUI review",
  "keywords": [
    "pi-package",
    "plan",
    "revdiff"
  ],
  "pi": {
    "extensions": [
      "./"
    ]
  },
  "scripts": {
